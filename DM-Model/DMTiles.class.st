Class {
	#name : 'DMTiles',
	#superclass : 'CMTileset',
	#category : 'DM-Model',
	#package : 'DM-Model'
}

{ #category : 'initialization' }
DMTiles class >> elevation: aLevel [
	<tile>
	| pictures |
	pictures := #(
		''
		''
		'' ).
	^ self tiles
		at: ('elevation' , aLevel printString) asSymbol
		ifAbsentPut: [ CMTile newFrom: (pictures at: aLevel) ]
]

{ #category : 'as yet unclassified' }
DMTiles class >> highValueTree [
	<tile>
	^ self tiles at: #highValueTree ifAbsentPut: [ CMTile newFrom: '' ]
]

{ #category : 'as yet unclassified' }
DMTiles class >> lowValueTree [
	<tile>
	^ self tiles at: #lowValueTree ifAbsentPut: [ CMTile newFrom: '' ]
]
